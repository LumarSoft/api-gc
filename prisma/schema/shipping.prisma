// Shipping: configurable delivery methods, carrier quotes and carrier shipments.

/// Coarse shipment state; the carrier's own wording is kept in `Shipment.carrierStatus`.
enum ShipmentStatus {
  /// Waiting to be created at the carrier, or created and not handed over yet.
  PENDING
  IN_TRANSIT
  /// Waiting at a carrier branch for the buyer.
  READY_FOR_PICKUP
  DELIVERED
  /// On its way back to the store, or already returned.
  RETURNED
  CANCELLED
  LOST
}

/// Admin-editable configuration of each delivery method (rates and thresholds are data, not code).
model ShippingMethod {
  id                    Int            @id @default(autoincrement())
  code                  DeliveryMethod @unique
  name                  String         @db.VarChar(100)
  description           String?        @db.VarChar(255)
  /// Human description of the covered area, e.g. "Rosario y Gran Rosario".
  coverage              String?        @db.VarChar(255)
  /// Fixed price (LOCAL_DELIVERY). Null when quoted (CARRIER) or free (STORE_PICKUP).
  flatRate              Decimal?       @db.Decimal(12, 2)
  /// Order subtotal from which shipping is free. Null = never free.
  freeShippingThreshold Decimal?       @db.Decimal(12, 2)
  currency              Currency       @default(ARS)
  minDeliveryDays       Int?
  maxDeliveryDays       Int?
  sortOrder             Int            @default(0)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?
}

/// One option the provider offered for a cart and destination. The buyer picks one by id at checkout; it is copied
/// to the Shipment when the order is placed. Operational log: no deletedAt (see database.md).
model ShippingQuote {
  id            Int      @id @default(autoincrement())
  cartId        Int
  /// SHA-256 of the quoted cart lines (variant and quantity): a cart with other contents needs a new quote.
  itemsHash     String   @db.VarChar(64)
  postalCode    String   @db.VarChar(10)
  city          String   @db.VarChar(100)
  province      String   @db.VarChar(100)
  /// Carrier id at the provider, needed to create the shipment with this option.
  carrierId     Int
  carrier       String   @db.VarChar(60)
  /// Provider codes of the delivery mode (e.g. standard_delivery, pickup_point) and the dispatch mode.
  serviceType   String   @db.VarChar(40)
  logisticType  String   @db.VarChar(40)
  service       String   @db.VarChar(100)
  /// Carrier branch where the buyer picks the parcel up (branch delivery only).
  pickupPointId Int?
  pickupPoint   String?  @db.VarChar(255)
  /// What the buyer pays, VAT included.
  amount        Decimal  @db.Decimal(12, 2)
  /// What the store pays the provider, VAT included.
  cost          Decimal  @db.Decimal(12, 2)
  currency      Currency
  minDays       Int?
  maxDays       Int?
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  cart Cart @relation(fields: [cartId], references: [id])

  @@index([cartId])
}

/// A parcel sent through the carrier provider (CARRIER orders). Pickup and Rosario delivery have no shipment row.
model Shipment {
  id             Int            @id @default(autoincrement())
  orderId        Int
  method         DeliveryMethod
  status         ShipmentStatus @default(PENDING)
  carrier        String?        @db.VarChar(60)
  service        String?        @db.VarChar(100)
  /// Selection copied from the chosen ShippingQuote; the provider needs it to create the shipment.
  carrierId      Int?
  serviceType    String?        @db.VarChar(40)
  logisticType   String?        @db.VarChar(40)
  pickupPointId  Int?
  pickupPoint    String?        @db.VarChar(255)
  /// Status as the carrier words it (e.g. "En camino"), shown as is next to the coarse `status`.
  carrierStatus  String?        @db.VarChar(100)
  trackingNumber String?        @db.VarChar(100)
  trackingUrl    String?        @db.VarChar(500)
  /// Shipment id at the carrier/aggregator.
  externalId     String?        @unique @db.VarChar(100)
  /// What the company pays the carrier (the customer's price is Order.shippingTotal).
  cost           Decimal?       @db.Decimal(12, 2)
  currency       Currency       @default(ARS)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}
