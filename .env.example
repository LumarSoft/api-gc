# Copy to .env: `cp .env.example .env`

PORT=3001

# Comma-separated list of allowed origins. The Next.js front runs on 3000.
CORS_ORIGIN=http://localhost:3000

# Matches docker-compose.yml. `prisma migrate dev` needs to create a shadow database,
# so locally use root (the `cg` user has no CREATE DATABASE permission).
DATABASE_URL="mysql://root:root@localhost:3306/cg"

# mariadb pool tuning (see src/prisma/prisma.service.ts)
DB_POOL_CONNECTION_LIMIT=10
DB_POOL_IDLE_TIMEOUT=60

# Auth. Generate the secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Front URL, used in email links (password reset, email verification).
FRONT_URL=http://localhost:3000

# Auth cookies. Locally leave COOKIE_DOMAIN empty and COOKIE_SECURE=false.
# In production: COOKIE_SECURE=true and COOKIE_DOMAIN=.<shared-parent-domain> so front and API share the session.
COOKIE_DOMAIN=
COOKIE_SECURE=false
