# Copy to .env: `cp .env.example .env`

PORT=3001

# Comma-separated list of allowed origins. The Next.js front runs on 3000.
CORS_ORIGIN=http://localhost:3000

# Matches docker-compose.yml. `prisma migrate dev` needs to create a shadow database,
# so locally use root (the `cg` user has no CREATE DATABASE permission).
DATABASE_URL="mysql://root:root@localhost:3306/cg"

# Optional. Database for `npm run test:e2e`; defaults to DATABASE_URL with `_test` appended to the name (cg_test).
# Must not be the development database. Created and migrated automatically before each e2e run.
# TEST_DATABASE_URL="mysql://root:root@localhost:3306/cg_test"

# mariadb pool tuning (see src/prisma/prisma.service.ts)
DB_POOL_CONNECTION_LIMIT=10
DB_POOL_IDLE_TIMEOUT=60

# Auth. Generate the secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Front URL, used in email links (password reset, email verification).
FRONT_URL=http://localhost:3000

# Auth cookies. Locally leave COOKIE_DOMAIN empty and COOKIE_SECURE=false.
# In production: COOKIE_SECURE=true and COOKIE_DOMAIN=.<shared-parent-domain> so front and API share the session.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Number of reverse proxies in front of the API (nginx, load balancer…). 0 locally; usually 1 in production.
# Needed so rate limits see the real client IP instead of the proxy's.
TRUST_PROXY=0

# Uploaded files. STORAGE_DIR is a local folder (git-ignored); PUBLIC_FILES_URL is where its public part is served.
STORAGE_DIR=storage
PUBLIC_FILES_URL=http://localhost:3001/files

# Carrier shipping to the rest of the country through Zipnova (quotes, labels, tracking). Leave the credentials empty
# to keep it off: checkout then shows the carrier option as unavailable.
# Key and secret: Zipnova panel → Configuración → Integraciones → Gestionar credenciales y webhooks (also shows the
# account id). ZIPNOVA_ORIGIN_ID is the id of the dispatch location (Configuración → Ubicaciones; the quote response
# also returns it as origin.location_id).
ZIPNOVA_API_URL=https://api.zipnova.com.ar/v2
ZIPNOVA_API_KEY=
ZIPNOVA_API_SECRET=
ZIPNOVA_ACCOUNT_ID=
ZIPNOVA_ORIGIN_ID=
# Optional prefix for our shipment references in Zipnova (letters, digits, dashes; up to 12). Set it when several
# databases share one Zipnova account (each developer, staging), e.g. DEV-MATEO-, so they never find each other's
# shipments. Leave it empty in production.
ZIPNOVA_REFERENCE_PREFIX=
# Secret part of the webhook URL registered in Zipnova (topic "status"): <API URL>/shipping/webhooks/<secret>.
# At least 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZIPNOVA_WEBHOOK_SECRET=

# Online payment with Mercado Pago Checkout Pro. Leave the access token empty to keep it off: checkout then only offers
# paying at the store. Mercado Pago → Tus integraciones → <app> → Credenciales. For sandbox use the access token of a
# seller test user (APP_USR-…, see docs/upgrade-notes.md); a TEST-… token of your own account also works.
MERCADO_PAGO_API_URL=https://api.mercadopago.com
MERCADO_PAGO_ACCESS_TOKEN=
# Signature secret of the webhooks (Tus integraciones → <app> → Webhooks → Clave secreta). Without it every
# notification is refused, and payments are confirmed only when the buyer comes back to the store.
MERCADO_PAGO_WEBHOOK_SECRET=
# Public https URL of POST /payments/webhooks/mercado-pago, sent with each checkout. Leave it empty locally (Mercado
# Pago cannot reach localhost) unless you expose the API with a tunnel.
MERCADO_PAGO_NOTIFICATION_URL=
# Optional prefix for our references at Mercado Pago (letters, digits, dashes; up to 20). Set it when several databases
# share one Mercado Pago account (each developer, staging), e.g. DEV-MATEO-, so they never take each other's payments.
# Leave it empty in production.
MERCADO_PAGO_REFERENCE_PREFIX=
